SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Antigravity Vision Estimation & Google Cloud Configuration
ANTIGRAVITY_VERTEX=false
GOOGLE_CLOUD_PROJECT=gen-lang-client-0446733469
GOOGLE_CLOUD_LOCATION=us-west1
ANTIGRAVITY_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your_gemini_api_key

# Telegram Lead Alerts & Dispatch (Real-time dispatch alerts directly to Brandon's phone)
