# Go Fetch, Gizmo! Environment Variables

# Database Configuration (Supabase PostgreSQL / Netlify PostgreSQL or local SQLite fallback)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Antigravity Vision Estimation & Google Cloud Configuration
ANTIGRAVITY_VERTEX=false
GOOGLE_CLOUD_PROJECT=gen-lang-client-0446733469
GOOGLE_CLOUD_LOCATION=us-west1
ANTIGRAVITY_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your_gemini_api_key

# SMS Gateway Provider ('textbee' or 'twilio')
SMS_GATEWAY=textbee

# TextBee Android SMS Gateway (https://textbee.dev)
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=

# Twilio SMS / MMS (Alternative Gateway)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+19165468537

# Telegram Lead Alerts (1-tap booking alerts directly to your phone)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email / SMTP Outbound for B2B Property Managers (e.g. Gmail App Password or custom SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME="Brandon @ Go Fetch, Gizmo!"

# Server settings
PORT=8000
HOST=localhost
